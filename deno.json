{
  "name": "freshpack",
  "tasks": {
    "dev": "deno run --watch main.ts"
  },
  "workspace": {
    "members": [
      "packages/runtime",
      "packages/babel",
      "packages/webpack"
    ]
  },
  "imports": {
    "@babel/core": "npm:@babel/core@^7.28.5",
    "@babel/plugin-transform-react-jsx": "npm:@babel/plugin-transform-react-jsx@^7.27.1",
    "@babel/preset-env": "npm:@babel/preset-env@^7.28.5",
    "@babel/preset-typescript": "npm:@babel/preset-typescript@^7.28.5",
    "@deno/loader": "jsr:@deno/loader@^0.3.9",
    "@fresh/build-id": "jsr:@fresh/build-id@^1.0.1",
    "@fresh/core": "jsr:@fresh/core@^2.1.3",
    "@modern-js/inspector-webpack-plugin": "npm:@modern-js/inspector-webpack-plugin@^1.0.6",
    "@preact/signals": "npm:@preact/signals@^2.5.1",
    "@prefresh/core": "npm:@prefresh/core@^1.5.8",
    "@prefresh/utils": "npm:@prefresh/utils@^1.2.1",
    "@prefresh/webpack": "npm:@prefresh/webpack@^4.0.6",
    "@std/assert": "jsr:@std/assert@^1.0.15",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/media-types": "jsr:@std/media-types@^1.1.0",
    "@std/path": "jsr:@std/path@^1.1.2",
    "babel-loader": "npm:babel-loader@^10.0.0",
    "enhanced-resolve": "npm:enhanced-resolve@^5.18.3",
    "events": "npm:events@^3.3.0",
    "mobx-react-lite": "npm:mobx-react-lite@^4.1.1",
    "preact": "npm:preact@^10.27.2",
    "webpack": "npm:webpack@^5.102.1",
    "webpack-cli": "npm:webpack-cli@^6.0.1",
    "webpack-dev-middleware": "npm:webpack-dev-middleware@^7.4.5",
    "webpack-dev-server": "npm:webpack-dev-server@^5.2.2"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "exports": {
    "./webpack": "./webpack.ts",
    "./babel": "./babel.ts",
    "./fresh": "./fresh.ts",
    "./hmr": "./freshpack/hmr/client.ts"
  }
}
