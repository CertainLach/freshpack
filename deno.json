{
  "nodeModulesDir": "manual",
  "exclude": [
    "**/_fresh/*",
    "**/tmp/*",
    "*/tests_OLD/**",
    "pnpm-lock.yaml"
  ],
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "deno.ns",
      "deno.unstable"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended",
        "fresh",
        "jsr",
        "jsx",
        "react"
      ],
      "exclude": [
        "no-window"
      ],
      "include": [
        "no-console"
      ]
    }
  }
}
