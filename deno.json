{
  "tasks": {
    "dev": "deno run -A --watch-hmr dev.ts",
    "build": "deno run -A build.ts",
    "run": "deno run --allow-env=DENO_DEPLOYMENT_ID,GITHUB_SHA,CI_COMMIT_SHA --allow-net=0.0.0.0:8000 --allow-read=_fresh main.ts",
    "compile": "deno compile --include _fresh --allow-env=DENO_DEPLOYMENT_ID,GITHUB_SHA,CI_COMMIT_SHA --allow-net=0.0.0.0:8000 main.ts"
  },
  "workspace": {
    "members": [
      "packages/runtime",
      "packages/babel",
      "packages/webpack"
    ]
  },
  "imports": {
    "@babel/core": "npm:@babel/core@^7.28.5",
    "@babel/plugin-transform-react-jsx": "npm:@babel/plugin-transform-react-jsx@^7.27.1",
    "@babel/preset-env": "npm:@babel/preset-env@^7.28.5",
    "@babel/preset-typescript": "npm:@babel/preset-typescript@^7.28.5",
    "@deno/loader": "jsr:@deno/loader@^0.3.10",
    "@fresh/build-id": "jsr:@fresh/build-id@^1.0.1",
    "@fresh/core": "jsr:@fresh/core@^2.2.0",
    "@preact/signals": "npm:@preact/signals@^2.5.1",
    "@prefresh/core": "npm:@prefresh/core@^1.5.9",
    "@prefresh/utils": "npm:@prefresh/utils@^1.2.1",
    "@std/assert": "jsr:@std/assert@^1.0.16",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/media-types": "jsr:@std/media-types@^1.1.0",
    "@std/path": "jsr:@std/path@^1.1.3",
    "@std/ulid": "jsr:@std/ulid@^1.0.0",
    "babel-loader": "npm:babel-loader@^10.0.0",
    "copy-webpack-plugin": "npm:copy-webpack-plugin@^13.0.1",
    "memfs": "npm:memfs@^4.51.0",
    "preact": "npm:preact@^10.27.2",
    "webpack": "npm:webpack@^5.103.0"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  }
}
