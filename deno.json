{
  "nodeModulesDir": "none",
  "workspace": [
    "./packages/*",
    "example"
  ],
  "tasks": {
    "dev": "deno run -A --watch-hmr dev.ts",
    "build": "deno run -A build.ts",
    "run": "deno run --allow-env=DENO_DEPLOYMENT_ID,GITHUB_SHA,CI_COMMIT_SHA --allow-net=0.0.0.0:8000 --allow-read=_fresh main.ts",
    "compile": "deno task build && deno compile --include dist --allow-env=DENO_DEPLOYMENT_ID,GITHUB_SHA,CI_COMMIT_SHA --allow-net=0.0.0.0:8000 main.ts",
    "test": "deno test -A --parallel",
    "check:types": "deno check --allow-import",
    "ok": "deno fmt --check && deno lint && deno task check:types && deno task test"
  },
  "exclude": [
    "**/_fresh/*",
    "**/tmp/*",
    "*/tests_OLD/**"
  ],
  "publish": {
    "include": [
      "src/**",
      "deno.json",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "**/*_test.*",
      "src/__OLD/**",
      "*.todo",
      "**/tests/**"
    ]
  },
  "imports": {
    "@babel/core": "npm:@babel/core@^8.0.1",
    "@babel/plugin-transform-react-jsx": "npm:@babel/plugin-transform-react-jsx@^8.0.1",
    "@babel/preset-env": "npm:@babel/preset-env@^8.0.2",
    "@babel/preset-typescript": "npm:@babel/preset-typescript@^8.0.1",
    "@deno/loader": "jsr:@deno/loader@^0.5.0",
    "@prefresh/core": "npm:@prefresh/core@^1.5.10",
    "@prefresh/utils": "npm:@prefresh/utils@^1.2.1",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/ulid": "jsr:@std/ulid@^1.0.0",
    "babel-loader": "npm:babel-loader@^10.1.1",
    "copy-webpack-plugin": "npm:copy-webpack-plugin@^14.0.0",
    "memfs": "npm:memfs@^4.57.8",
    "webpack": "npm:webpack@^5.108.4",
    "@deno/doc": "jsr:@deno/doc@^0.202.1",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/collections": "jsr:@std/collections@^1.3.0",
    "@std/http": "jsr:@std/http@^1.1.2",
    "@std/net": "jsr:@std/net@^1.0.6",
    "@std/uuid": "jsr:@std/uuid@^1.1.1",
    "preact": "npm:preact@^10.29.7",
    "preact-render-to-string": "npm:preact-render-to-string@^6.7.0",
    "@opentelemetry/api": "npm:@opentelemetry/api@^1.9.1",
    "@preact/signals": "npm:@preact/signals@^2.10.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/fmt": "jsr:@std/fmt@^1.0.10",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/html": "jsr:@std/html@^1.0.7",
    "@std/jsonc": "jsr:@std/jsonc@^1.0.2",
    "@std/media-types": "jsr:@std/media-types@^1.1.0",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/semver": "jsr:@std/semver@^1.0.8",
    "@std/streams": "jsr:@std/streams@^1.1.1",
    "@astral/astral": "jsr:@astral/astral@^0.5.6",
    "@marvinh-test/fresh-island": "jsr:@marvinh-test/fresh-island@^0.0.3",
    "linkedom": "npm:linkedom@^0.18.13",
    "@std/async": "jsr:@std/async@^1.5.0",
    "@std/expect": "jsr:@std/expect@^1.0.20",
    "@std/testing": "jsr:@std/testing@^1.0.19"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "deno.ns",
      "deno.unstable"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended",
        "fresh",
        "jsr",
        "jsx",
        "react"
      ],
      "exclude": [
        "no-window"
      ],
      "include": [
        "no-console"
      ]
    }
  }
}
